@model LanguageModel
<div class="container">
    <h3 class="display-4">Add New Language</h3>
    <hr />

    <form id="languageForm" method="post" enctype="multipart/form-data" asp-action="AddNewLangauge" asp-controller="Book">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Add Language" class="btn btn-primary" />
        </div>
    </form>

    <!-- Success message div, initially hidden -->
    <div id="successMessage" style="display:none; color: green; font-weight: bold; margin-top: 20px;"></div>

    <script>
        $(document).ready(function() {
            // Attach AJAX form submission manually
            $('#languageForm').submit(function(event) {
                event.preventDefault(); // Prevent the default form submission

                // Get form data
                var formData = new FormData(this);

                // Send AJAX request
                        $.ajax({
            url: $(this).attr('action'), // URL from asp-action
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    // Display success message from server response
                    // Show the success message in the div
                        $('#successMessage').text(response.message).show(); // Update and show the div

                    // Optionally, reset the form
                    $('form').trigger("reset");
                } else {
                    // If success is false, show the error message
                    alert('Failed: ' + response.message);
                    //console.log('Failed to add language');
                }
            },
            error: function(xhr, status, error) {
                // Handle any AJAX errors here
                alert('An error occurred: ' + error);
                //console.log('Error:', error);
            },
            complete: function(xhr, status) {
                // Handle after request completes
                //console.log('AJAX Request completed with status:', status);
            }
        });

            });
        });
    </script>




</div>
