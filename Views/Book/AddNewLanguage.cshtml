@model LanguageModel
<div class="container">
<h3 class="display-4">Add New Language</h3>
<hr />

@if (ViewBag.IsSuccess == true)
{
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">Done</h4>
        <br />
        Click <a asp-controller="Book" asp-action="GetBook" asp-route-id="@ViewBag.BookId">here</a>
        <p>You have added successfully </p>
        <hr>
    </div>
}
<form method="post" enctype="multipart/form-data" data-ajax="true" data-ajax-complete="myComplete" data-ajax-success="mySuccess"
      data-ajax-failure="myFailure" asp-action="AddNewLangauge" asp-controller="Book">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Add Language" class="btn btn-primary" />
    </div>
</form>
</div>
