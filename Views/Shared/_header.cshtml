@* This is the header file. *@

@using WebApplication7.Repository

@inject IBookRepository _bookRepo

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Include Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<!-- Include Font Awesome CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    header nav ul {
        display: flex;
        justify-content: space-between; /* Pushes left items left and right items right */
        padding: 0;
        margin: 5px;
        list-style: none;
        align-items: center; /* Vertically center items */
    }

        header nav ul .left-items {
            margin-right: 20px; /* Space between left items */
        }

        header nav ul .right-icons {
            display: flex;
            align-items: center;
        }

            header nav ul .right-icons li {
                margin-left: 20px; /* Space between right icons */
            }

    .notification-icon {
        position: relative;
        display: inline-block;
    }

        .notification-icon .fas {
            font-size: 20px;
            color: #333;
        }

    .fa-bell {
        margin: -10px;
    }
</style>

<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="collapse navbar-collapse d-sm-inline-flex flex-sm-row-reverse">
            <ul class="navbar-nav">
               <partial name="_LoginInfo" />
            </ul>
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-dark icon-link" asp-controller="Home" asp-action="Index" title="Home"><i class="fas fa-house"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="aboutus" title="About"><i class="fas fa-info-circle"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="contactus" title="Contact"><i class="fas fa-envelope"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="book" asp-action="getallbooks" title="All Book"> <i class="fas fa-book"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="book" asp-action="getalllanguage" title="All Language"><i class="fas fa-language"></i></a>
                </li>               
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="book" asp-action="addnewbook" title="Book">Add New <i class="fas fa-book"></i></a>
                </li>                
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="book" asp-action="addnewlanguage" title="Language">Add New <i class="fas fa-language"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="dropdown" asp-action="multidropdown">Form</a>
                </li>
            </ul>            
        </div>
    </nav>
</header>

